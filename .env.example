# Local PostgreSQL/PostGIS settings used by Docker Compose and the Python code.
# Copy this file to .env and choose a password before starting PostgreSQL.
# Port 5433 and the datlas names keep this installation apart from other
# PostGIS containers on the same machine.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=datlas
POSTGRES_USER=datlas
POSTGRES_PASSWORD=change-this-local-password

# Optional isolated clean-room database beside an existing installation:
# POSTGRES_PORT=55433
# POSTGRES_CONTAINER_NAME=datlas_cleanroom_postgres
# COMPOSE_PROJECT_NAME=datlas_cleanroom

# Dagster container (docker/dagster.yml): it runs as this user and group so
# that it can write .dagster_home/ and data/ in the checkout. Set both to the
# output of `id -u` and `id -g`; with the wrong values the container cannot
# write its run storage and restarts in a loop.
DAGSTER_UID=1000
DAGSTER_GID=1000
# Host port of the web UI.
# DAGSTER_PORT=3001

# Rolling window in hours (1-24, default 24) for the forecast partitions and
# the GRIB files. Files of older runs are deleted once their run is no longer
# in the database, which keeps the newest two complete runs.
FORECAST_RETENTION_HOURS=24

# DAGSTER_HOME must be an absolute path. Before starting Dagster, run:
# export DAGSTER_HOME="$PWD/.dagster_home"

# Personal Zensus 2022 API token (free registration at
# https://ergebnisse.zensus2022.de/). Never commit a real value.
# ZENSUS2022_TOKEN=
